<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.30-10" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="filoliveira" created="2026-06-08" changedby="filoliveira" changed="2026-06-08" origin="Structorizer 3.30-10" text="&#34;int main(void)&#34;,&#34;Auteur: AOD&#34;,&#34;Date: 08.06.2026&#34;,&#34;Description: Code du programme principal, permetant communiquer avec l'utilisateur&#34;,&#34;                         et de faire des appels aux differentes fonctions du loto&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;// Initialisation des variables locales&#34;,&#34;optionUser =: 0&#34;,&#34;reponseUser =: 0&#34;,&#34;lotoName[41] =: &#34;&#34;&#34;&#34;&#34;,&#34;cheminLog[60] =: &#34;&#34;Logs/&#34;&#34;&#34;" comment="" color="c0c0c0" rotated="0" disabled="0"></instruction>
		<repeat text="&#34;until ((lotoName[0] != Quitter) ET (lotoName[1] != 0))&#34;" comment="" color="80ffff" disabled="0">
			<qRepeat>
				<call text="&#34;Affichage de Menu et demande a l'utilisateur le nom du Loto&#34;" comment="" color="ffff80" disabled="0"></call>
				<call text="&#34;Récéption du nom du loto écrit par l'utilisateur dans lotoName&#34;" comment="" color="ffff80" disabled="0"></call>
				<alternative text="&#34;((lotoName[0] != Quitter) ET (lotoName[1] != 0))&#34;" comment="" color="ffffff" disabled="0">
					<qTrue>
						<call text="&#34;Tetative d'ouverture du fichier en mode read&#34;" comment="" color="ff8000" disabled="0"></call>
						<alternative text="&#34;(Si fichier peut etre lu)&#34;" comment="" color="ffffff" disabled="0">
							<qTrue>
								<call text="&#34;Fermeture du fichier&#34;" comment="" color="ff8000" disabled="0"></call>
								<call text="&#34;Affichage des options et récéption de l'option choisit par l'utilisateur dans optionUser&#34;" comment="" color="ffff80" disabled="0"></call>
								<case text="&#34;(optionUser)&#34;,&#34;OPTION_1&#34;,&#34;OPTION_2&#34;,&#34;OPTION_3&#34;,&#34;OPTION_4&#34;,&#34;OPTION_5&#34;,&#34;OPTION_6&#34;,&#34;OPTION_7&#34;,&#34;OPTION_8&#34;,&#34;default&#34;" comment="" color="ffffff" disabled="0">
									<qCase>
										<call text="&#34;Appel de la fonction TheBestWinnumber comme parametre d'entrée cheminLog&#34;" comment="" color="80ff80" disabled="0"></call>
									</qCase>
									<qCase>
										<call text="&#34;Appel de la fonction TheBadestNumber comme parametre d'entrée cheminLog&#34;" comment="" color="80ff80" disabled="0"></call>
									</qCase>
									<qCase>
										<call text="&#34;Appel de la fonction WinNumbers comme parametre d'entrée cheminLog&#34;" comment="" color="80ff80" disabled="0"></call>
									</qCase>
									<qCase>
										<call text="&#34;Appel de la fonction LoseNumbers comme parametre d'entrée cheminLog&#34;" comment="" color="80ff80" disabled="0"></call>
									</qCase>
									<qCase>
										<call text="&#34;Appel de la fonction EcritureValeur comme parametre d'entrée cheminLog&#34;" comment="" color="80ff80" disabled="0"></call>
									</qCase>
									<qCase>
										<call text="&#34;Appel de la fonction SupressionValeur comme parametre d'entrée cheminLog&#34;" comment="" color="80ff80" disabled="0"></call>
									</qCase>
									<qCase>
										<call text="&#34;Appel de la fonction ModificationValeur comme parametre d'entrée cheminLog&#34;" comment="" color="80ff80" disabled="0"></call>
									</qCase>
									<qCase>
										<call text="&#34;Appel de la fonction Simulation comme parametre d'entrée cheminLog&#34;" comment="" color="80ff80" disabled="0"></call>
									</qCase>
									<qCase>
										<call text="&#34;Message de reponse incomprise&#34;" comment="" color="ff8080" disabled="0"></call>
									</qCase>
								</case>
							</qTrue>
							<qFalse>
								<repeat text="&#34;until ((reponseUser != OUI) ET (reponseUser != oui) ET (reponseUser != NON) ET (reponseUser != non))&#34;" comment="" color="80ffff" disabled="0">
									<qRepeat>
										<call text="&#34;Message de demande de création de loto et recupération de la reponse dans reponseUser&#34;" comment="" color="ffff80" disabled="0"></call>
										<alternative text="&#34;((reponseUser = OUI) OU (reponseUser = oui))&#34;" comment="" color="ffffff" disabled="0">
											<qTrue>
												<call text="&#34;Appel de la fonction NouveauLoto comme parametre d'entrée cheminLog et lotoName&#34;" comment="" color="80ff80" disabled="0"></call>
												<instruction text="" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
											</qTrue>
											<qFalse>
												<alternative text="&#34;((reponseUser = NON) OU (reponseUser = non))&#34;" comment="" color="ffffff" disabled="0">
													<qTrue>
														<call text="&#34;Message de retour au menu&#34;" comment="" color="ffff80" disabled="0"></call>
														<instruction text="" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
													</qTrue>
													<qFalse>
														<call text="&#34;Message de reponse incomprise&#34;" comment="" color="ff8080" disabled="0"></call>
														<instruction text="" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
													</qFalse>
												</alternative>
											</qFalse>
										</alternative>
									</qRepeat>
								</repeat>
							</qFalse>
						</alternative>
					</qTrue>
					<qFalse>
						<call text="&#34;Message de fermeture du programme&#34;" comment="" color="ffff80" disabled="0"></call>
						<instruction text="" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qFalse>
				</alternative>
			</qRepeat>
		</repeat>
	</children>
</root>