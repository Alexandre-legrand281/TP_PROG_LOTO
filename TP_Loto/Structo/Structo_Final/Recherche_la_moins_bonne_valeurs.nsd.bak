<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.30-10" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="valmermoud" created="2026-06-08" changedby="valmermoud" changed="2026-06-08" origin="Structorizer 3.30-10" text="&#34;Recherche la moins bonne valeurs &#34;,&#34;Paramètre&#34;,&#34;entrée&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;Déclaration de compteur_copie_flop de 101 cases&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;Mise en copie de compteur dans compteur_flop&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;for rang &#60;- 0 to 6&#34;" comment="" counterVar="rang" startValue="0" endValue="6" stepConst="1" style="COUNTER" color="ffff80" disabled="0">
			<qFor>
				<instruction text="&#34;Déclaration min_occurrences =: 999999&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;Déclaration pire_num =: -1&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<for text="&#34;for i = valeur.valMin &#60;- i &#60;= valeur.valMax i++&#34;" comment="" counterVar="i = valeur.valMin" startValue="i &#60;= valeur.valMax i++" stepConst="1" style="FREETEXT" color="ffff80" disabled="0">
					<qFor>
						<alternative text="&#34;Si compteur_copie_flop[i] est plus grand que 0 et que compteur_copie_flop[i] est plus petit que min_occurrences&#34;" comment="" color="ffff80" disabled="0">
							<qTrue>
								<instruction text="&#34;min_occurrences =: compteur_copie_flop[i]&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
								<instruction text="&#34;pire_num =: i;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
							</qTrue>
							<qFalse color="ffffff">
							</qFalse>
						</alternative>
					</qFor>
				</for>
				<alternative text="&#34;Si pire_num est different de -1&#34;" comment="" color="ffff80" disabled="0">
					<qTrue>
						<instruction text="&#34;valeur.numeroPerdant[rang] =: pire_num&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
						<alternative text="&#34;Si rang vaut 0 &#34;" comment="" color="ffff80" disabled="0">
							<qTrue>
								<instruction text="&#34;valeur.pireValeur =: pire_num&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
							</qTrue>
							<qFalse color="ffffff">
							</qFalse>
						</alternative>
						<instruction text="&#34;compteur_copie_flop[pire_num] =: 999999&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse>
						<instruction text="&#34;valeur.numeroPerdant[rang] =: 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						<alternative text="&#34;Si rang vaut 0&#34;" comment="&#34;&#34;" color="ffff80" disabled="0">
							<qTrue>
								<instruction text="&#34;valeur.pireValeur := 0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
							</qTrue>
							<qFalse color="ffffff">
							</qFalse>
						</alternative>
					</qFalse>
				</alternative>
			</qFor>
		</for>
	</children>
</root>